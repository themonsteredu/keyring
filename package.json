{
  "name": "keyring",
  "version": "1.0.0",
  "private": true,
  "description": "ESP32-C3 스마트 감정·날씨 키링 — 오프라인 OLED 설정",
  "scripts": {
    "test": "bash tools/test.sh",
    "test:e2e": "playwright test",
    "build": "bash tools/build.sh",
    "dev": "python3 tools/dev_server.py --port 8000",
